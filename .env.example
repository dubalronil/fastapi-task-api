# Copy this file to .env and fill in real values.
# .env is gitignored so your real secrets never get committed.
# These defaults match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://tasks:tasks@localhost:5432/tasks

# Browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
# true switches to one JSON object per line, for production log collectors.
LOG_JSON=false
